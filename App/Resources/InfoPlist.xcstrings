    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchKit controls playback in Music and Spotify, and reads your Terminal or iTerm tabs for developer activities."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchKit, Müzik ve Spotify'da çalmayı kontrol eder ve geliştirici etkinlikleri için Terminal veya iTerm sekmelerinizi okur."
          }
        }
      }
    },
    "NSAppleMusicUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show upcoming songs and playlists from Apple Music."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Music'teki sıradaki şarkıları ve çalma listelerini göstermek için kullanılır."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchKit listens to your music app's audio on this Mac to time lyrics word by word. The audio never leaves your Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchKit, şarkı sözlerini kelime kelime zamanlamak için müzik uygulamanızın sesini bu Mac'te dinler. Ses Mac'inizden asla çıkmaz."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show new Bluetooth connections and low battery notices."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni Bluetooth bağlantılarını ve düşük pil uyarılarını göstermek için kullanılır."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show upcoming events."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşan etkinlikleri göstermek için kullanılır."
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "localizations": {

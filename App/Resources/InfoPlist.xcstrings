    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by the Mirror widget so you can see yourself in the notch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayna widget'ı tarafından kullanılır; böylece kendinizi çentikte görebilirsiniz."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to find the right contact when replying to a notification."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bildirime yanıt verirken doğru kişiyi bulmak için kullanılır."
          }
        }
      }
    },
    "NSFocusStatusUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to show live Focus updates."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı Odak güncellemelerini göstermek için kullanılır."
          }
        }

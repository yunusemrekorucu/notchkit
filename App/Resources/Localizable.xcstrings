          }
        }
      }
    },
    "Keep your Mac awake while NotchKit's caffeinate mode is active, even with the lid closed.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchKit'in Uyanık Tut modu etkinken, kapak kapalı olsa bile Mac'inizi uyanık tut."
          }
        }
      }
    },
    "Keep your Mac awake, clamshell sleep behavior, and lid-angle display controls.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizi uyanık tutma, kapak kapalı uyku davranışı ve kapak açısına bağlı ekran denetimleri."

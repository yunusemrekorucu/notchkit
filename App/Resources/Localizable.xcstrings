    "Auto-start a focus session at a set time of day — daily, on specific days of the week, weekly, monthly, or once.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün belirli bir saatinde Odak oturumunu otomatik başlat — her gün, haftanın belirli günlerinde, haftalık, aylık veya bir kez."
          }
        }
      }
    },
    "Automate charging behaviors and perform manual or scheduled calibrations to keep your battery's readings accurate.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarj davranışlarını otomatikleştirin ve pil değerlerinin doğru kalması için elle veya zamanlanmış kalibrasyon yapın."

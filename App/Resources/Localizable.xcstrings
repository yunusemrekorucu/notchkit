            "state": "translated",
            "value": "1:1, hassas işaretçi hareketi için macOS imleç ivmesini kapat; oyun ve tasarım işleri için harika."
          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings to ask about settings.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar hakkında soru sormak için Sistem Ayarları'nda Apple Intelligence'ı açın."
          }
        }
      }
    },
    "Turn on Dev Activity in Settings to see AI agents, builds and terminal commands here.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {

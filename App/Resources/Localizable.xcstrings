          "stringUnit": {
            "state": "translated",
            "value": "Gerçek Android ana ekran widget'larını Mac masaüstüne koy."
          }
        }
      }
    },
    "Put the display into real macOS display sleep when the lid drops below the chosen angle, then wake it again when reopened. This will attempt to keep caffinate activated while the display is sleeping.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak seçilen açının altına indiğinde ekranı gerçek macOS ekran uykusuna al, yeniden açıldığında uyandır. Ekran uykudayken Uyanık Tut'u etkin tutmaya çalışır."
          }
        }
      }
    },
    "Put the lock screen's widgets on native Liquid Glass.": {
      "extractionState": "manual",

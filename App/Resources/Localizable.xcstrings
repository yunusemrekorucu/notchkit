          "stringUnit": {
            "state": "translated",
            "value": "Her widget'ı ayıran ince bir çizgi göster."
          }
        }
      }
    },
    "Display a visual graph of your work and break intervals.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışma ve mola aralıklarınızın görsel bir grafiğini göster."
          }
        }
      }
    },
    "Display an authentication status activity in the notch on the lock screen.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit ekranında çentikte bir kimlik doğrulama durumu etkinliği göster."
          }
        }
      }
    },
    "Display app volume in the normal volume HUD (like Spotify). When disabled, only shows with Option + Volume keys.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama sesini normal ses HUD'unda göster (Spotify gibi). Devre dışıyken yalnızca Option + Ses tuşlarıyla gösterilir."
          }
        }
      }
    },
    "Display brightness as a row of dots instead of a bar.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlaklığı çubuk yerine bir nokta dizisi olarak göster."
          }

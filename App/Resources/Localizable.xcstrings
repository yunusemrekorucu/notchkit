    "Automatically hide the music live activity when Spotify or Music is the frontmost app.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify veya Müzik en öndeki uygulamayken müzik canlı etkinliğini otomatik gizle."
          }
        }
      }
    },
    "Automatically lock and unlock your Mac using a trusted Bluetooth device.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenilen bir Bluetooth aygıtıyla Mac'inizi otomatik olarak kilitleyin ve kilidini açın."
          }
        }
      }
    },
    "Automatically matches the orientation reported by the camera. If an external camera feed appears rotated, choose a fixed angle to display it upright.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranın bildirdiği yönle otomatik eşleşir. Harici bir kamera görüntüsü döndürülmüş görünüyorsa, dik göstermek için sabit bir açı seçin."
          }
        }
      }
    },
    "Automatically pause now playing media and resume when the lid opens back up.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalan medyayı otomatik duraklat ve kapak yeniden açıldığında sürdür."
          }
        }
      }
    },
    "Automatically pauses charging if the battery temperature gets too high to prevent heat-related damage and extend its lifespan.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isıdan kaynaklanan hasarı önlemek ve ömrünü uzatmak için pil sıcaklığı çok yükselirse şarjı otomatik duraklatır."
          }
        }
      }
    },
    "Automatically pauses music or videos when the screen locks.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran kilitlendiğinde müziği veya videoları otomatik duraklatır."
          }
        }
      }
    },
    "Automatically shrink images, compress media, and extract text with OCR.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüleri otomatik küçült, medyayı sıkıştır ve OCR ile metin çıkar."
          }
        }
      }
    },
    "Automatically start a break after each focus block.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her odak bloğundan sonra otomatik olarak mola başlat."
          }
        }
      }
    },
    "Automatically translate non-English lyrics.": {
      "extractionState": "manual",

      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı bekleniyor…"
          }
        }
      }
    },
    "Waiting for camera access. Allow NotchKit in the system prompt.": {

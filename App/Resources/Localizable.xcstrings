    "We are committed to your privacy. We DO NOT automatically collect, store, or transmit any personal or sensitive information. This includes, but is not limited to:\\n• Your name, email, or other personal identifiers\\n• Screen contents or keyboard input\\n• Application data from other apps": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizliliğinize bağlıyız. Hiçbir kişisel veya hassas bilgiyi otomatik olarak TOPLAMAZ, SAKLAMAZ veya İLETMEYİZ. Bunlar şunları içerir ancak bunlarla sınırlı değildir:\\n• Adınız, e-postanız veya diğer kişisel tanımlayıcılarınız\\n• Ekran içeriği veya klavye girişi\\n• Diğer uygulamaların uygulama verileri"
          }
        }
      }
    },
    "We believe in transparency. Please review our data handling practices below.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şeffaflığa inanıyoruz. Lütfen veri işleme uygulamalarımızı aşağıdan inceleyin."
          }
        }
      }
    },
    "Weather": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava Durumu"
          }
        }
      }
    },
    "Weather & Environment": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava Durumu ve Ortam"
          }
        }
      }
    },
    "Weather API key is not configured.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu API anahtarı yapılandırılmamış."
          }
        }
      }
    },
    "Weather Live Activity Popup Interval": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava Durumu Canlı Etkinliği Açılır Pencere Aralığı"
          }
        }
      }
    },
    "Weather data is temporarily unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu verileri geçici olarak kullanılamıyor."
          }
        }
      }
    },
    "Weather widget data sources, units, and location-based behavior.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hava durumu widget'ının veri kaynakları, birimleri ve konuma dayalı davranışı."
          }
        }
      }
    },
    "Web Data": {
      "extractionState": "manual",
      "localizations": {

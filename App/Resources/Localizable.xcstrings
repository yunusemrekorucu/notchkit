    "Native charge limit": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel şarj sınırı"
          }
        }
      }
    },
    "Native drives the phone as a real Bluetooth keyboard and mouse — Android's own pointer, hover, right-click and wheel. NotchKit cursor draws an overlay pointer and injects gestures instead.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel mod, telefonu gerçek bir Bluetooth klavye ve fare olarak kullanır — Android'in kendi işaretçisi, üzerine gelme, sağ tık ve tekerlek. NotchKit imleci ise bunun yerine bir bindirme işaretçisi çizer ve hareketleri enjekte eder."
          }
        }
      }
    },
    "Navigation, timers, downloads and calls appear as live activities in the notch.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigasyon, zamanlayıcılar, indirmeler ve aramalar çentikte canlı etkinlikler olarak görünür."
          }
        }
      }
    },
    "Nearby": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındakiler"
          }
        }
      }
    },
    "Nearby Concerts": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki Konserler"
          }
        }
      }
    },
    "Nearby Share": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby Share"
          }
        }
      }
    },
    "Nearby Share allows you to share files from Android phones to your Mac using Android's native file sharing (Nearby Share / Quick Share). It's recommended to keep this feature enabled for convenient sharing from family and friends.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby Share, Android'in yerleşik dosya paylaşımını (Nearby Share / Quick Share) kullanarak Android telefonlardan Mac'inize dosya paylaşmanızı sağlar. Aile ve arkadaşlarınızdan kolayca dosya alabilmek için bu özelliği açık tutmanız önerilir."
          }
        }
      }
    },
    "Nearby concerts": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki konserler"
          }
        }
      }
    },
    "Nearby sharing preferences, transfers, and device discovery options.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki paylaşım tercihleri, aktarımlar ve aygıt bulma seçenekleri."
          }
        }
      }
    },
    "Needed for media key presses, window snapping, and HUDs.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortam tuşları, pencere yerleştirme ve HUD'lar için gereklidir."
          }
        }
      }
    },
    "Needed to control playback and get track info from Spotify and Music.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify ve Müzik'te oynatmayı denetlemek ve parça bilgisini almak için gereklidir."
          }
        }
      }
    },
    "Needed to detect connected devices and their battery levels.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı aygıtları ve pil düzeylerini algılamak için gereklidir."
          }
        }
      }
    },
    "Needed to discover and control supported media players on your network.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağınızdaki desteklenen medya oynatıcıları keşfetmek ve denetlemek için gereklidir."
          }
        }
      }
    },
    "Needed to provide live weather updates for your current location.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunduğunuz konum için canlı hava durumu güncellemeleri sunmak için gereklidir."
          }
        }
      }
    },
    "Needed to show custom alerts for messages and system events.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar ve sistem etkinlikleri için özel uyarılar göstermek için gereklidir."
          }
        }
      }
    },
    "Needed to show when a Focus mode is active.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Odak modunun ne zaman etkin olduğunu göstermek için gereklidir."

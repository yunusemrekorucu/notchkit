      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verdikleriniz dışındaki tüm uygulamaları engeller. Yalnızca birkaç aracın olması gereken derin çalışma oturumları için idealdir."
          }
        }
      }
    },
    "Blocks only the apps (and websites) you add to the list. Everything else stays accessible.": {

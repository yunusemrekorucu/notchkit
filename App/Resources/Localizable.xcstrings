    "Hide and show menu bar items using an expandable section.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu öğelerini genişletilebilir bir bölümle gizleyin ve gösterin."
          }
        }
      }
    },
    "Hide everything, including essentials like the volume and brightness HUD.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve parlaklık HUD'u gibi temel öğeler dahil her şeyi gizle."
          }
        }
      }
    },
    "Hide from Mixer": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karıştırıcıdan Gizle"
          }
        }
      }
    },
    "Hide from Screen Sharing": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran Paylaşımından Gizle"
          }
        }
      }
    },
    "Hide live activities in full screen": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekranda canlı etkinlikleri gizle"
          }
        }
      }
    },
    "Hide long-running activities like music, timers and persistent stats. Short events like HUDs, notifications and Caps Lock still show.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik, zamanlayıcılar ve kalıcı istatistikler gibi uzun süren etkinlikleri gizle. HUD'lar, bildirimler ve Caps Lock gibi kısa olaylar yine de görünür."
          }
        }
      }
    },
    "Hide music widget if no media is playing": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya çalmıyorsa müzik widget'ını gizle"
          }
        }
      }
    },
    "Hide on phone": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonda gizle"
          }
        }
      }
    },
    "Hide on phone is the default. Turning the waveform off entirely is available when right-side track info is Always.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonda gizle varsayılandır. Sağ taraftaki parça bilgisi Her Zaman olarak ayarlandığında dalga biçimini tamamen kapatabilirsiniz."
          }
        }
      }
    },
    "Hide only the activities you pick.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca seçtiğiniz etkinlikleri gizle."
          }
        }
      }
    },
    "Hide pinned apps from the Dock — an app's icon appears only while it's running.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmiş uygulamaları Dock'tan gizle — uygulama simgesi yalnızca çalışırken görünür."
          }
        }
      }
    },
    "Hide the finance activity outside regular US trading hours.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finans etkinliğini normal ABD işlem saatleri dışında gizle."
          }
        }
      }
    },
    "Hide the lyrics line under the music live activity so it doesn't cover the full-screen app. The song still shows.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran uygulamayı kapatmaması için müzik canlı etkinliğinin altındaki şarkı sözü satırını gizle. Şarkı yine de görünür."
          }
        }
      }
    },
    "Hide the lyrics line while an app is full screen, on every display. Set it per display in Appearance → Displays.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulama tam ekrandayken şarkı sözü satırını her ekranda gizle. Ekran başına Görünüm → Ekranlar'dan ayarlayın."
          }
        }
      }
    },
    "Hide the music widget when Spotify is paused and no other system media is playing": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify duraklatılmışken ve başka sistem medyası çalmıyorken müzik widget'ını gizle"
          }
        }
      }
    },
    "Hide the notch completely while an app is full screen.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulama tam ekranken çentiği tamamen gizle."
          }
        }
      }
    },
    "Hide the notch until something is happening, on every display.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey olana kadar çentiği her ekranda gizle."
          }
        }
      }
    },
    "Hide the notch until something is happening.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şey olana kadar çentiği gizle."
          }
        }
      }
    },
    "Hide the notch while an app is full screen, on every display.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uygulama tam ekrandayken çentiği her ekranda gizle."
          }
        }
      }
    },
    "Hide the notch while nothing is happening. It appears for any live activity.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey olmuyorken çentiği gizle. Herhangi bir canlı etkinlikte görünür."
          }
        }
      }
    },
    "Hide the notch while nothing is happening. It still appears for activities that aren't hidden, like the volume HUD.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey olmuyorken çentiği gizle. Ses HUD'u gibi gizlenmemiş etkinlikler için yine görünür."
          }
        }
      }
    },
    "Hide the sports activity when no favorite team has a live game.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir favori takımın canlı maçı yokken spor etkinliğini gizle."
          }
        }
      }

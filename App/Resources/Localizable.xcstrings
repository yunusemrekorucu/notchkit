          "stringUnit": {
            "state": "translated",
            "value": "Tek kulaklıkta gürültü engellemeyi açık tut"
          }
        }
      }
    },
    "Keep only a few apps on screen; switching to another tucks the oldest one away (restored when the session ends).": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranda yalnızca birkaç uygulama tut; başkasına geçmek en eskisini gizler (oturum bitince geri yüklenir)."
          }
        }
      }
    },
    "Keep score and game clock visible while you work.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışırken skoru ve maç saatini görünür tut."
          }
        }
      }
    },
    "Keep showing the current track in lock screen widgets even when playback is paused.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {

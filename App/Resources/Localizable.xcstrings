    "Block During Breaks": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Molalarda Engelle"
          }
        }
      }
    },
    "Block distracting apps and websites during focus sessions.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odak oturumları sırasında dikkat dağıtan uygulamaları ve web sitelerini engelle."
          }
        }
      }
    },
    "Block macOS's own iPhone Mirroring the moment it opens and start Android screen mirroring instead — useful if you have no iPhone and it's just a Dock entry that goes nowhere. Only blocks it while a phone is actually connected.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'in kendi iPhone Yansıtma özelliğini açıldığı anda engelle ve bunun yerine Android ekran yansıtmayı başlat — iPhone'unuz yoksa ve bu yalnızca hiçbir yere gitmeyen bir Dock girişiyse kullanışlıdır. Yalnızca bir telefon gerçekten bağlıyken engeller."
          }
        }
      }
    },
    "Block photos, videos, or screen captures from unlocking Face ID.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafların, videoların veya ekran görüntülerinin Face ID kilidini açmasını engelle."
          }
        }
      }
    },
    "Block selected apps": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili uygulamaları engelle"
          }
        }
      }
    },
    "Blocked Apps": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellenen Uygulamalar"
          }
        }
      }
    },
    "Blocked Websites": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellenen Web Siteleri"
          }
        }
      }
    },
    "Blocked apps are force-closed and notifications are hidden. Unblock requests wait 10 minutes (or until the session ends), and the session itself can't be stopped early.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellenen uygulamalar zorla kapatılır ve bildirimler gizlenir. Engel kaldırma istekleri 10 dakika (veya oturum bitene kadar) bekler ve oturumun kendisi erken durdurulamaz."
          }
        }
      }
    },
    "Blocked apps are force-closed the moment they open and notifications are hidden. No unblocking, but you can end the session anytime.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellenen uygulamalar açıldığı anda zorla kapatılır ve bildirimler gizlenir. Engel kaldırma yoktur, ancak oturumu istediğiniz zaman bitirebilirsiniz."
          }
        }
      }
    },
    "Blocking %lld distraction%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Blocking %1$lld distraction%2$@"

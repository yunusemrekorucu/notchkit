          }
        }
      }
    },
    "Keep the face recognition and liveness models loaded between unlocks so Face ID recognizes you from the first camera frame.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID sizi ilk kamera karesinden tanısın diye yüz tanıma ve canlılık modellerini kilit açmalar arasında yüklü tut."
          }
        }
      }
    },
    "Keep the music widget visible with the last track even when playback is paused or stopped": {
      "extractionState": "manual",
      "localizations": {
        "tr": {

    },
    "Tap the album art with two fingers to toggle playback.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatmayı açıp kapatmak için albüm kapağına iki parmakla dokunun."
          }
        }

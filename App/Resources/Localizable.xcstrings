    "Display a special HUD with the active device name when changing volume while Spotify is active.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotify etkinken ses değiştirilirken etkin aygıt adını içeren özel bir HUD göster."
          }
        }
      }
    },
    "Display a subtle line separating each widget.": {
      "extractionState": "manual",
      "localizations": {

    "Create a profile, add reveal conditions, and optionally bind it to a display, a Space, or a Focus filter. When a bound context is active and any condition is met, hidden items are revealed.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir profil oluşturun, gösterme koşulları ekleyin ve isteğe bağlı olarak bir ekrana, Space'e veya Odak filtresine bağlayın. Bağlı bağlam etkinken ve herhangi bir koşul karşılandığında gizli öğeler gösterilir."
          }
        }
      }
    },
    "Create an app at developer.tidal.com, enable the user.read, search.read, collection.read/write, and playlists.read/write scopes, and set the redirect URI exactly to notchkit://callback.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "developer.tidal.com adresinde bir uygulama oluşturun, user.read, search.read, collection.read/write ve playlists.read/write kapsamlarını etkinleştirin ve yönlendirme URI'sini tam olarak notchkit://callback olarak ayarlayın."
          }
        }
      }
    },

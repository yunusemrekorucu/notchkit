    "TIDAL accepted the login but did not issue a token. Check the Client ID, Client Secret and that the redirect URI is notchkit://callback.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TIDAL oturum açmayı kabul etti ancak bir belirteç vermedi. Client ID'yi, Client Secret'ı ve yönlendirme URI'sinin notchkit://callback olduğunu denetleyin."
          }
        }
      }

    },
    "Temperature unit. Off (the default) shows Fahrenheit (°F); on shows Celsius (°C).": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıcaklık birimi. Kapalıyken (varsayılan) Fahrenheit (°F), açıkken Celsius (°C) gösterilir."
          }
        }
      }
    },
    "Temperature(C)": {
      "extractionState": "manual",

            "value": "Çar"
          }
        }
      }
    },
    "Weekdays": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafta içi"
          }
        }
      }
    },
    "Weekly": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık"
          }
        }
      }
    },
    "Weekly Eye Break Activity": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık Göz Molası Etkinliği"
          }
        }
      }
    },
    "Weekly limit": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalık sınır"
          }
        }
      }
    },
    "Welcome": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoş Geldiniz"
          }
        }
      }
    },
    "Welcome to NotchKit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchKit’e Hoş Geldiniz"
          }
        }
      }
    },
    "Welcome, %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoş geldin, %@"
          }
        }
      }
    },
    "What This Includes:": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar Neleri İçerir:"
          }
        }
      }
    },
    "What can I change about the music player?": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Müzik çalar ile ilgili neleri değiştirebilirim?"
          }
        }
      }
    },
    "Wheel notches glide instead of jumping. Scrolling with ⌘, ⌥, ⌃ or ⇧ held stays immediate.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekerlek adımları sıçramak yerine kayar. ⌘, ⌥, ⌃ veya ⇧ basılıyken kaydırma anında kalır."
          }
        }
      }
    },
    "When NotchKit opens a DMG, mount it, install contained apps, unmount, and clean up automatically.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchKit bir DMG açtığında, bağla, içindeki uygulamaları yükle, bağlantıyı kes ve otomatik olarak temizle."
          }
        }
      }
    },
    "When NotchKit opens an archive, extract it automatically. Disable to hand archives back to macOS Archive Utility.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NotchKit bir arşiv açtığında otomatik olarak çıkar. Arşivleri macOS Arşiv Yardımcısı'na bırakmak için devre dışı bırakın."
          }
        }
      }
    },
    "When Spotify desktop on this Mac plays an ad, relaunch it in the background, then resume via Spotify Connect.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'teki Spotify masaüstü uygulaması reklam çaldığında, uygulamayı arka planda yeniden başlat ve Spotify Connect ile devam et."
          }
        }
      }
    },
    "When a Live Activity appears automatically.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Canlı Etkinliğin otomatik olarak göründüğü an."
          }
        }
      }
    },
    "When a song only has line timing, listen to the music app's audio on this Mac to time each word, and share good results. Asks for audio access and downloads Apple's speech model once.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şarkıda yalnızca satır zamanlaması varsa, her kelimeyi zamanlamak için müzik uygulamasının sesini bu Mac'te dinle ve iyi sonuçları paylaş. Ses erişimi ister ve Apple'ın konuşma modelini bir kez indirir."
          }
        }
      }
    },
    "When another app is playing, show a Spotify source tab so you can switch medias. Hidden while Spotify itself is the main media source.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir uygulama çalarken, medyalar arasında geçiş yapabilmeniz için bir Spotify kaynak sekmesi göster. Ana medya kaynağı Spotify'ın kendisiyken gizlenir."
          }
        }
      }
    },
    "When enabled, 100% app volume is capped by current system output volume.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinken, %100 uygulama sesi mevcut sistem çıkış sesiyle sınırlanır."
          }
        }
      }
    },
    "When enabled, your Mac will stop using AC power and run from its battery until the battery limit is reached.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinken Mac, AC güç kullanmayı bırakır ve pil sınırına ulaşılana kadar pille çalışır."
          }
        }
      }
    },
    "When more than one live activity is running, the ones after the first appear as small bubbles next to the notch, like the Dynamic Island. Click a bubble to open it.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla canlı etkinlik çalışırken, ilkinden sonrakiler Dynamic Island gibi çentiğin yanında küçük balonlar olarak görünür. Açmak için bir balona tıklayın."
          }
        }
      }
    },
    "When more than one phone is linked, pick a device each time you mirror or extend. Other features use the preferred (Active) phone, or sync to every linked phone where that makes sense (clipboard, Focus).": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla telefon bağlıyken, her yansıtma veya genişletmede bir aygıt seçin. Diğer özellikler tercih edilen (Etkin) telefonu kullanır veya anlamlı olduğu yerde (pano, Odak) bağlı tüm telefonlarla senkronize olur."
          }
        }
      }
    },
    "When on (and Music ▸ Live Activity lyrics is on), Continuity / phone tracks can show lyrics in the notch Live Activity.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken (ve Müzik ▸ Canlı Etkinlik şarkı sözleri açıkken), Süreklilik / telefon parçaları çentik Canlı Etkinliğinde şarkı sözlerini gösterebilir."
          }
        }
      }
    },
    "When re-opening the notch, it will return to the last menu you had open.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentik yeniden açıldığında, en son açık olan menüye döner."
          }
        }
      }
    },
    "When shown items would run into the app's menus or the notch, temporarily swap the menus out until the items hide again": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gösterilen öğeler uygulamanın menülerine veya çentiğe çarpacaksa, öğeler gizlenene kadar menüleri geçici olarak değiştir"
          }
        }
      }
    },
    "When the DMG contains an older or equal version of an installed app, keep the installed copy without asking.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DMG, yüklü bir uygulamanın daha eski veya aynı sürümünü içeriyorsa, sormadan yüklü kopyayı koru."
          }
        }
      }
    },
    "When the notch is collapsed, swipe up over it to hide it completely. Swipe down near the notch area to bring it back.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çentik daraltılmışken, tamamen gizlemek için üzerinde yukarı kaydırın. Geri getirmek için çentik alanının yakınında aşağı kaydırın."
          }
        }
      }
    },
    "When the phone is playing and this Mac is not, show it in the regular music Live Activity (album art on the left). Right-side track info, waveform mode, and waveform style are under Music settings ▸ Live Activity.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon çalıyor ve bu Mac çalmıyorsa, bunu normal müzik Canlı Etkinliğinde göster (solda albüm kapağı). Sağdaki parça bilgisi, dalga formu modu ve stili Müzik ayarları ▸ Canlı Etkinlik altındadır."
          }
        }
      }
    },
    "When this Mac or the phone starts playing, it reconnects the shared earbuds and the other device pauses. Seamless Connection is always free.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac veya telefon çalmaya başladığında, paylaşılan kulaklıklara yeniden bağlanır ve diğer aygıt duraklar. Kesintisiz Bağlantı her zaman ücretsizdir."
          }
        }
      }
    },
    "When this profile starts or ends here, do the same on Android.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil burada başladığında veya bittiğinde Android'de de aynısını yap."
          }
        }
      }
    },
    "When you copy a large image or screenshot, replace it on the clipboard with a smaller version automatically": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük bir görüntü veya ekran görüntüsü kopyaladığınızda, panoda otomatik olarak daha küçük bir sürümüyle değiştir"
          }
        }
      }
    },
    "When you drag a file out of the shelf, remove it from the shelf automatically.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dosyayı raftan sürüklediğinizde, onu raftan otomatik olarak kaldır."
          }
        }
      }
    },
    "When you open a disk image yourself, ask whether to install the app inside and eject it.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir disk görüntüsünü kendiniz açtığınızda, içindeki uygulamanın yüklenip yüklenmeyeceğini ve çıkarılıp çıkarılmayacağını sor."
          }
        }
      }
    },
    "Which live activities still show while an app is full screen, on every display.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekran bir uygulama varken, her ekranda hangi canlı etkinliklerin görünmeye devam edeceği."
          }
        }
      }
    },
    "Whichever device starts playing most recently takes the earbuds. Turn this off to only hand off when the buds themselves connect.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalmaya en son başlayan aygıt kulaklığı devralır. Yalnızca kulaklıklar bağlandığında devretmek için bunu kapatın."
          }
        }
      }
    },
    "While QuickTime is recording the screen, a movie or audio.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuickTime ekranı, bir filmi veya sesi kaydederken."
          }
        }
      }
    },
    "While Selected Apps Are Running": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili Uygulamalar Çalışırken"
          }
        }
      }
    },
    "While Voice Memos is recording.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli Notlar kayıt yaparken."
          }
        }
      }
    },
    "While a Meet tab in Chrome, Edge, Brave, Arc or Safari is using the microphone. Needs permission to control the browser.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chrome, Edge, Brave, Arc veya Safari’deki bir Meet sekmesi mikrofonu kullanırken. Tarayıcıyı denetleme izni gerekir."
          }
        }
      }
    },
    "While a Teams call or meeting is using the microphone.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Teams araması veya toplantısı mikrofonu kullanırken."
          }
        }
      }
    },
    "While a Webex meeting is using the microphone.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Webex toplantısı mikrofonu kullanırken."
          }
        }
      }
    },
    "While an External Display Is Connected": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harici Ekran Bağlıyken"
          }
        }
      }
    },
    "While caffeinated, set brightness to zero when the lid reaches the trigger angle. This does not put the display to sleep.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanık Tut açıkken, kapak tetikleyici açıya ulaştığında parlaklığı sıfıra ayarla. Bu, ekranı uykuya almaz."
          }
        }
      }
    },
    "While on AC Power": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AC Güçteyken"
          }
        }
      }
    },
    "While you're browsing on the Mac, opening a browser on the phone shows a pill to pick up where you left off. Needs permission to control your browser (System Settings ▸ Privacy & Security ▸ Automation).": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te gezinirken telefonda bir tarayıcı açmak, kaldığınız yerden devam etmeniz için bir hap gösterir. Tarayıcınızı denetleme izni gerekir (Sistem Ayarları ▸ Gizlilik ve Güvenlik ▸ Otomasyon)."
          }
        }
      }
    },
    "While you're connected to another Mac.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir Mac’e bağlıyken."
          }
        }
      }
    },
    "While you're in a huddle.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir huddle’dayken."
          }
        }
      }
    },
    "While you're in a meeting. Mute, video and sharing follow Zoom's own state.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir toplantıdayken. Sessize alma, video ve paylaşım Zoom’un kendi durumunu izler."
          }
        }
      }
    },
    "While you're in a voice channel.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sesli kanaldayken."
          }
        }
      }
    },
    "While you're on a FaceTime call.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir FaceTime aramasındayken."
          }
        }
      }
    },
    "White Noise": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beyaz Gürültü"
          }
        }
      }
    },
    "Wi-Fi": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi"
          }
        }
      }
    },
    "Wi-Fi Connected": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi Bağlı"
          }
        }
      }
    },
    "Wi-Fi Network Is": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi Ağı Şu"
          }
        }
      }
    },
    "Wi-Fi network name": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi ağ adı"
          }
        }
      }
    },
    "Widget & Activity": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget ve Etkinlik"
          }
        }
      }
    },
    "Widget Blur Radius Max": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget Bulanıklık Yarıçapı (En Çok)"
          }
        }
      }
    },
    "Widget Transitions": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget Geçişleri"
          }
        }
      }
    },
    "Widget View Style": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget Görünüm Stili"

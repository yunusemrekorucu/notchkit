    "": {},
    "\"%@\" is password protected": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” parola korumalı"
          }
        }
      }
    },
    "\"%@\" was already %@; nothing changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\"%1$@\" was already %2$@; nothing changed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” zaten şu durumdaydı: %2$@. Hiçbir şey değişmedi."
          }
        }
      }
    },
    "\"%@\" will be removed from your File Shelf. The actual file stays in place.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" dosya rafınızdan kaldırılacak. Asıl dosya olduğu yerde kalır."
          }
        }
      }
    },
